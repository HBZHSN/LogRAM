<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="LogRAM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="LogRAM"
        Icon="LogRAM.png"
        Width="1200"
        Height="760"
        MinWidth="820"
        MinHeight="520"
        Background="{DynamicResource WindowBackBrush}"
        Foreground="{DynamicResource TextBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop">

    <Grid x:Name="RootGrid" Background="{DynamicResource WindowBackBrush}" SizeChanged="RootGrid_SizeChanged">
        <Grid.Resources>
            <Style x:Key="LineNumberBoxStyle" TargetType="{x:Type TextBox}">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="IsReadOnlyCaretVisible" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,1,8,0" />
                <Setter Property="Background" Value="{DynamicResource LineNumberBackBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
                <Setter Property="Cursor" Value="Arrow" />
            </Style>

            <Style x:Key="LogContentBoxStyle" TargetType="{x:Type TextBox}">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="IsReadOnlyCaretVisible" Value="False" />
                <Setter Property="IsUndoEnabled" Value="False" />
                <Setter Property="IsInactiveSelectionHighlightEnabled" Value="True" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,1,12,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBackBrush}" />
                <Setter Property="SelectionTextBrush" Value="{DynamicResource SelectionTextBrush}" />
            </Style>

        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition x:Name="MainLogRow" Height="*" MinHeight="150" />
            <RowDefinition Height="6" />
            <RowDefinition x:Name="SearchResultsRow" Height="190" MinHeight="84" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource PanelAltBackBrush}"
                BorderBrush="{DynamicResource StrongBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="7,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="OpenButton"
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        Click="OpenButton_Click"
                        Content="打开"
                        ToolTip="打开日志文件" />

                <Button x:Name="RefreshButton"
                        Grid.Column="1"
                        Margin="0,0,6,0"
                        Click="RefreshButton_Click"
                        Content="刷新"
                        ToolTip="重新读取当前文件" />

                <ToggleButton x:Name="LiveRefreshButton"
                              Grid.Column="2"
                              Margin="0,0,6,0"
                              Checked="LiveRefreshButton_Checked"
                              Unchecked="LiveRefreshButton_Unchecked"
                              Content="实时"
                              ToolTip="实时增量刷新当前文件" />

                <ComboBox x:Name="EncodingComboBox"
                          Grid.Column="3"
                          SelectionChanged="EncodingComboBox_SelectionChanged"
                          ToolTip="编码">
                    <ComboBoxItem Content="UTF-8" />
                    <ComboBoxItem Content="GBK" />
                </ComboBox>

                <StackPanel Grid.Column="0"
                            Grid.ColumnSpan="7"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock Text="LogRAM"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               VerticalAlignment="Center" />
                    <TextBlock Text="FAST IS EVERYTHING"
                               Margin="8,5,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Opacity="0.6"
                               FontWeight="SemiBold"
                               FontSize="10"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button x:Name="SettingsButton"
                        Grid.Column="5"
                        Margin="0,0,6,0"
                        HorizontalAlignment="Right"
                        Click="SettingsButton_Click"
                        Content="设置"
                        ToolTip="调整字体与字号" />

                <Popup x:Name="SettingsPopup"
                       PlacementTarget="{Binding ElementName=SettingsButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       Opened="SettingsPopup_Opened">
                    <Border Margin="0,4,0,0"
                            Background="{DynamicResource PanelBackBrush}"
                            BorderBrush="{DynamicResource StrongBorderBrush}"
                            BorderThickness="1"
                            Padding="12">
                        <StackPanel Width="260">
                            <TextBlock x:Name="FontLabel"
                                       Text="字体"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,0,0,4" />
                            <ComboBox x:Name="FontFamilyComboBox"
                                      SelectionChanged="FontFamilyComboBox_SelectionChanged" />
                            <TextBlock x:Name="FontSizeLabel"
                                       Text="字号"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,10,0,4" />
                            <ComboBox x:Name="FontSizeComboBox"
                                      SelectionChanged="FontSizeComboBox_SelectionChanged" />
                            <TextBlock x:Name="LanguageLabel"
                                       Text="语言"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,10,0,4" />
                            <ComboBox x:Name="LanguageComboBox"
                                      SelectionChanged="LanguageComboBox_SelectionChanged">
                                <ComboBoxItem Content="中文" />
                                <ComboBoxItem Content="English" />
                            </ComboBox>

                            <Separator Margin="0,12,0,8"
                                       Background="{DynamicResource BorderBrush}" />

                            <TextBlock x:Name="FileAssocLabel"
                                       Text="文件类型绑定"
                                       Foreground="{DynamicResource TextBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock x:Name="FileAssocHintLabel"
                                       Text="绑定后可通过右键或双击直接使用 LogRAM 打开以下类型文件"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />

                            <CheckBox x:Name="AssociateLogCheckBox"
                                      Content=".log"
                                      Foreground="{DynamicResource TextBrush}"
                                      Margin="0,2,0,0"
                                      Checked="FileAssociationCheckBox_Changed"
                                      Unchecked="FileAssociationCheckBox_Changed" />
                            <CheckBox x:Name="AssociateTxtCheckBox"
                                      Content=".txt"
                                      Foreground="{DynamicResource TextBrush}"
                                      Margin="0,2,0,0"
                                      Checked="FileAssociationCheckBox_Changed"
                                      Unchecked="FileAssociationCheckBox_Changed" />

                             <Button x:Name="ApplyFileAssociationButton"
                                    Content="应用绑定"
                                    Margin="0,10,0,0"
                                    Click="ApplyFileAssociationButton_Click"
                                    ToolTip="将选中的文件类型绑定到 LogRAM" />

                            <Separator Margin="0,12,0,8"
                                       Background="{DynamicResource BorderBrush}" />

                            <TextBlock x:Name="VersionTextBlock"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Popup>

                <ToggleButton x:Name="ThemeToggleButton"
                              Grid.Column="6"
                              HorizontalAlignment="Right"
                              Checked="ThemeToggleButton_Checked"
                              Unchecked="ThemeToggleButton_Unchecked"
                              Content="深色"
                              ToolTip="切换深色/浅色模式" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource LogBackBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid x:Name="MainLogGrid" PreviewMouseWheel="MainLogGrid_PreviewMouseWheel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" PreviewMouseLeftButtonDown="MainLog_PreviewMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LogLineNumberColumn" Width="94" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="LogHighlightBar"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            VerticalAlignment="Top"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"
                            Background="{DynamicResource SelectionBackBrush}" />
                    <Border Grid.Column="0"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,1,0">
                        <TextBox x:Name="LogLineNumberBox" Style="{StaticResource LineNumberBoxStyle}" />
                    </Border>
                    <TextBox x:Name="LogContentBox"
                             Grid.Column="1"
                             Style="{StaticResource LogContentBoxStyle}"
                             VerticalScrollBarVisibility="Disabled"
                             HorizontalScrollBarVisibility="Auto"
                             SizeChanged="LogContentBox_SizeChanged">
                        <TextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="LogCopyMenuItem" Header="复制" Command="Copy" />
                                <MenuItem x:Name="LogSelectAllMenuItem" Header="全选" Command="SelectAll" />
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>
                </Grid>

                <Border x:Name="LogScrollTrack"
                        Grid.Column="1"
                        Background="{DynamicResource ScrollTrackBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,0,0,0"
                        MouseLeftButtonDown="LogScrollTrack_MouseLeftButtonDown"
                        MouseMove="LogScrollTrack_MouseMove"
                        MouseLeftButtonUp="LogScrollTrack_MouseLeftButtonUp"
                        LostMouseCapture="LogScrollTrack_LostMouseCapture"
                        SizeChanged="LogScrollTrack_SizeChanged">
                    <Border x:Name="LogScrollThumb"
                            Width="12"
                            MinHeight="24"
                            Height="48"
                            Background="{DynamicResource ScrollThumbBrush}"
                            BorderBrush="{DynamicResource ScrollThumbBorderBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="LogScrollThumbTransform" />
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="2"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource PanelAltBackBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="0,1"
                      Cursor="SizeNS"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext" />

        <Border Grid.Row="3"
                Background="{DynamicResource LogBackBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource PanelAltBackBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="7,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ToggleButton x:Name="CaseSensitiveButton"
                                      Grid.Column="0"
                                      Width="44"
                                      Margin="0,0,4,0"
                                      VerticalAlignment="Center"
                                      Content="Aa"
                                      ToolTip="区分大小写" />

                        <ToggleButton x:Name="RegexButton"
                                      Grid.Column="1"
                                      Width="44"
                                      Margin="0,0,4,0"
                                      VerticalAlignment="Center"
                                      Content=".*"
                                      ToolTip="正则表达式" />

                        <Button x:Name="AdvancedSearchButton"
                                Grid.Column="2"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Click="AdvancedSearchButton_Click"
                                Content="高级"
                                ToolTip="高级搜索：自定义包含/排除关键词" />

                        <Popup x:Name="AdvancedSearchPopup"
                               PlacementTarget="{Binding ElementName=AdvancedSearchButton}"
                               Placement="Top"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               Opened="AdvancedSearchPopup_Opened">
                            <Border Margin="0,0,0,4"
                                    Background="{DynamicResource PanelBackBrush}"
                                    BorderBrush="{DynamicResource StrongBorderBrush}"
                                    BorderThickness="1"
                                    Padding="12">
                                <StackPanel Width="320">
                                    <TextBlock x:Name="AdvancedTitleLabel"
                                               Text="高级搜索"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,2" />
                                    <TextBlock x:Name="AdvancedHintLabel"
                                               Text="命中条件：包含任一“包含”关键词，且不包含任何“排除”关键词。仅支持 ASCII 关键词。"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8" />

                                    <TextBlock x:Name="IncludeLabel"
                                               Text="包含任一（OR）"
                                               Foreground="{DynamicResource TextBrush}"
                                               Margin="0,0,0,4" />
                                    <StackPanel x:Name="AdvancedIncludePanel" />
                                    <Button x:Name="AddIncludeButton"
                                            Content="+ 添加包含"
                                            HorizontalAlignment="Left"
                                            Margin="0,6,0,0"
                                            Click="AddIncludeKeyword_Click" />

                                    <Separator Margin="0,12,0,8"
                                               Background="{DynamicResource BorderBrush}" />

                                    <TextBlock x:Name="ExcludeLabel"
                                               Text="排除任一（NOT）"
                                               Foreground="{DynamicResource TextBrush}"
                                               Margin="0,0,0,4" />
                                    <StackPanel x:Name="AdvancedExcludePanel" />
                                    <Button x:Name="AddExcludeButton"
                                            Content="+ 添加排除"
                                            HorizontalAlignment="Left"
                                            Margin="0,6,0,0"
                                            Click="AddExcludeKeyword_Click" />

                                    <Separator Margin="0,12,0,8"
                                               Background="{DynamicResource BorderBrush}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="AdvancedCloseButton"
                                                Grid.Column="0"
                                                Content="关闭"
                                                HorizontalAlignment="Left"
                                                Click="AdvancedSearchClose_Click" />
                                        <Button x:Name="AdvancedRunButton"
                                                Grid.Column="1"
                                                Content="搜索"
                                                MinWidth="64"
                                                Click="AdvancedSearchRun_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <TextBlock x:Name="SearchResultStatusTextBlock"
                                   Grid.Column="3"
                                   Margin="6,0,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center" />

                        <TextBox x:Name="SearchTextBox"
                                 Grid.Column="4"
                                 Margin="12,0,8,0"
                                 VerticalAlignment="Center"
                                 KeyDown="SearchTextBox_KeyDown"
                                 ToolTip="搜索文本或正则" />

                        <Button x:Name="SearchButton"
                                Grid.Column="5"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Click="SearchButton_Click"
                                Content="搜索"
                                ToolTip="开始搜索" />

                        <Button x:Name="CancelSearchButton"
                                Grid.Column="6"
                                VerticalAlignment="Center"
                                Click="CancelSearchButton_Click"
                                Content="取消"
                                ToolTip="取消搜索" />
                    </Grid>
                </Border>

                <Grid x:Name="SearchGrid"
                      Grid.Row="1"
                      PreviewMouseWheel="SearchGrid_PreviewMouseWheel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SearchLineNumberColumn" Width="94" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,1,0">
                            <TextBox x:Name="SearchLineNumberBox"
                                     Style="{StaticResource LineNumberBoxStyle}"
                                     Foreground="{DynamicResource WarningBrush}" />
                        </Border>
                        <TextBox x:Name="SearchContentBox"
                                 Grid.Column="1"
                                 Style="{StaticResource LogContentBoxStyle}"
                                 VerticalScrollBarVisibility="Disabled"
                                 HorizontalScrollBarVisibility="Auto"
                                 SizeChanged="SearchContentBox_SizeChanged"
                                 PreviewMouseLeftButtonUp="SearchContentBox_PreviewMouseLeftButtonUp">
                            <TextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="SearchCopyMenuItem" Header="复制" Command="Copy" />
                                    <MenuItem x:Name="SearchSelectAllMenuItem" Header="全选" Command="SelectAll" />
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>
                    </Grid>

                    <Border x:Name="SearchScrollTrack"
                            Grid.Column="1"
                            Background="{DynamicResource ScrollTrackBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1,0,0,0"
                            MouseLeftButtonDown="SearchScrollTrack_MouseLeftButtonDown"
                            MouseMove="SearchScrollTrack_MouseMove"
                            MouseLeftButtonUp="SearchScrollTrack_MouseLeftButtonUp"
                            LostMouseCapture="SearchScrollTrack_LostMouseCapture"
                            SizeChanged="SearchScrollTrack_SizeChanged">
                        <Border x:Name="SearchScrollThumb"
                                Width="12"
                                MinHeight="24"
                                Height="48"
                                Background="{DynamicResource ScrollThumbBrush}"
                                BorderBrush="{DynamicResource ScrollThumbBorderBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="SearchScrollThumbTransform" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource PanelAltBackBrush}">
            <Grid Margin="8,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="FilePathTextBlock"
                           Grid.Column="0"
                           HorizontalAlignment="Left"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <TextBlock x:Name="MemoryStatusTextBlock"
                           Grid.Column="1"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="FileSizeTextBlock"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="EncodingStatusTextBlock"
                               Margin="14,0,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="SearchStatusTextBlock"
                               Margin="14,0,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               VerticalAlignment="Center" />
                    <ProgressBar x:Name="SearchProgressBar"
                                 Width="180"
                                 Height="7"
                                 Margin="14,0,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Visibility="Collapsed"
                                 VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
